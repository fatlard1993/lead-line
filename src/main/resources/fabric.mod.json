  "authors": [
    "justfatlard"
  ],
  "contact": {
    "sources": "https://github.com/fatlard1993/lead-line"
  },
  "license": "MIT",
  "icon": "assets/lead-line-justfatlard/icon.png",
  "environment": "*",
  "entrypoints": {
